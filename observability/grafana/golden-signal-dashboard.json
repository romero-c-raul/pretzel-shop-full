{
  "title": "Pretzel Shop — Golden Signals",
  "uid": "pretzel-golden",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "row",
      "title": "Traffic",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "HTTP request rate",
      "gridPos": { "x": 0, "y": 1, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (http_route) (rate(otel_http_server_duration_milliseconds_count[5m]))",
          "legendFormat": "{{http_route}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Latency",
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "HTTP latency (ms)",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(otel_http_server_duration_milliseconds_bucket[5m])))",
          "legendFormat": "p95 {{http_route}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum by (le, http_route) (rate(otel_http_server_duration_milliseconds_bucket[5m])))",
          "legendFormat": "p90 {{http_route}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le, http_route) (rate(otel_http_server_duration_milliseconds_bucket[5m])))",
          "legendFormat": "p50 {{http_route}}",
          "refId": "C"
        }
      ]
    },
    {
      "type": "table",
      "title": "Traces (Tempo)",
      "gridPos": { "x": 12, "y": 10, "w": 12, "h": 8 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "queryType": "nativeSearch",
          "serviceName": "pretzel-backend",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Errors",
      "gridPos": { "x": 0, "y": 17, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "logs",
      "title": "App errors (Loki)",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{container=\"pretzel-shop-full-backend-1\"} |~ `(?i)error`",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error rate",
      "gridPos": { "x": 0, "y": 26, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(otel_http_server_duration_milliseconds_count{http_status_code=~\"5..\"}[5m])) / sum(rate(otel_http_server_duration_milliseconds_count[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Saturation",
      "gridPos": { "x": 0, "y": 34, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "type": "text",
      "title": "DB connection pool (saturation)",
      "gridPos": { "x": 0, "y": 35, "w": 12, "h": 4 },
      "options": {
        "content": "Add postgres_exporter",
        "mode": "markdown"
      }
    },
    {
      "type": "text",
      "title": "Redis memory (saturation)",
      "gridPos": { "x": 12, "y": 35, "w": 12, "h": 4 },
      "options": {
        "content": "Add redis_exporter",
        "mode": "markdown"
      }
    }
  ],
  "time": { "from": "now-1h", "to": "now" }
}