{
  "name": "pretzel-shop-backend",
  "version": "1.0.0",
  "description": "Backend API for Pretzel Shop",
  "main": "server.js",
  "scripts": {
    "start": "node -r ./instrumentation.js server.js",
    "dev": "nodemon -r ./instrumentation.js server.js",
    "migrate": "node scripts/migrate.js",
    "lint": "eslint .",
    "test:integration": "node --test --test-concurrency=1 'test/integration/**/*.test.js'"
